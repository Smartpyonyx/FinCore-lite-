# FinCore Lite v0.1 - Environment Configuration Example
# Copy this file to .env and fill in your values

# ==================== APP ====================
APP_NAME=FinCore Lite
APP_VERSION=0.1.0
DEBUG=false

# ==================== DATABASE ====================
# PostgreSQL with asyncpg driver
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://fincore:fincore_secret@db:5432/fincore_lite
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# ==================== REDIS ====================
# Redis for caching and sessions
REDIS_URL=redis://redis:6379/0
CACHE_TTL=300

# ==================== SECURITY ====================
# CRITICAL: Generate a strong 256-bit (32-byte) secret key for production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production-256-bits-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== PASSWORD HASHING (Argon2id) ====================
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ==================== MFA (TOTP) ====================
MFA_ISSUER=FinCore Lite
MFA_ENABLED_FOR_OWNER=true
MFA_ENABLED_FOR_ACCOUNTANT=true

# ==================== M-PESA DARAJA ====================
# Environment: sandbox | production
MPESA_ENV=sandbox
MPESA_SHORTCODE=174379
# Get these from Safaricom Developer Portal
MPESA_PASSKEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=https://api.fincore.africa/v1/mpesa/callback
# Safaricom IP ranges for webhook verification
MPESA_IP_WHITELIST=["196.201.214.0/24", "196.201.213.0/24"]

# ==================== EXCHANGE RATES ====================
# Provider: cbk | open_exchange_rates
EXCHANGE_RATE_PROVIDER=open_exchange_rates
EXCHANGE_RATE_API_KEY=
CRYPTO_RATE_PROVIDER=coingecko
FIAT_RATE_REFRESH_HOURS=24
CRYPTO_RATE_REFRESH_MINUTES=60

# ==================== RATE LIMITING ====================
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW_SECONDS=900

# ==================== CORS ====================
# Comma-separated list of allowed origins
CORS_ORIGINS=["https://app.fincore.africa", "http://localhost:3000", "http://localhost:8080"]

# ==================== TRUSTED HOSTS ====================
TRUSTED_HOSTS=["*.fincore.africa", "localhost", "127.0.0.1"]

# ==================== AUDIT ====================
AUDIT_LOG_RETENTION_DAYS=2555

# ==================== PERFORMANCE ====================
MAX_CONNECTIONS=1000
WORKERS=4